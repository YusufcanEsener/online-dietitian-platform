# =============================================
# ENVIRONMENT DEĞİŞKENLERİ ŞABLONU
# Bu dosyayı .env olarak kopyalayıp doldurun:
#   cp .env.production .env   (sunucu için)
#   cp .env.development .env  (lokal için)
# =============================================

# === GENEL ===
NODE_ENV=production

# === BACKEND ===
BACKEND_PORT=8000
SECRET_KEY=              # Güçlü rastgele anahtar (openssl rand -hex 32)
MONGODB_URL=mongodb://mongo:27017
DATABASE_NAME=online_dietitian_v1
GOOGLE_CLIENT_ID=        # Google Cloud Console
GOOGLE_CLIENT_SECRET=    # Google Cloud Console

# === N8N ===
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/

# === CORS ===
# Virgülle ayırın. Sunucu IP/domain yazın.
CORS_ORIGINS=http://SUNUCU_IP:3000,http://SUNUCU_IP:8000

# === FRONTEND ===
FRONTEND_PORT=3000
# Production: boş bırakın (nginx proxy). Development: http://localhost:8000
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
