# =============================================
# ENVIRONMENT DEĞİŞKENLERİ ŞABLONU
# Bu dosyayı sunucuda .env.production olarak kopyalayıp doldurun:
#   cp .env.example .env.production
# Sonra gerçek değerleri yazın.
# =============================================

# === GENEL ===
NODE_ENV=production

# === MONGODB ROOT (admin işlemleri — sadece DB yönetimi) ===
# Oluşturmak için: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_ROOT_USERNAME=dietitian_admin
MONGO_ROOT_PASSWORD=              # ZORUNLU: min 32 karakter

# === MONGODB APP USER (backend bağlantısı — sınırlı yetki) ===
MONGO_APP_USERNAME=dietitian_app
MONGO_APP_PASSWORD=               # ZORUNLU: min 32 karakter

# === BACKEND ===
# Oluşturmak için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=                       # ZORUNLU: 64 hex karakter
DATABASE_NAME=online_dietitian_v1
GOOGLE_CLIENT_ID=                 # Google Cloud Console
GOOGLE_CLIENT_SECRET=             # Google Cloud Console

# === N8N ===
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=          # ZORUNLU: min 20 karakter

# === CORS ===
# Virgülle ayırın. Sadece production domain yazın.
CORS_ORIGINS=http://demo.yusufcanesener.com,https://demo.yusufcanesener.com

# === FRONTEND ===
FRONTEND_PORT=3000
# Production: boş bırakın (nginx proxy). Development: http://localhost:8000
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
